import BanachDensity1D.Chains

/-!
# Section 6.3: safe histories, the finite-evidence history topology, protected sets

Kleinberg–Wei, Part *Dimension one*, Sections 3.3 and 6.3.

* `History X` is the space `ℋ` of finite strictly descending chains of languages of `X`, with
  arbitrary starting language.
* `H⌢M` appends `M` (`History.snoc`); appending a root-to-leaf path of a tree rooted at `end(H)`
  writes the common language once (`appendPath`).
* The finite-evidence history topology is generated by the basic neighbourhoods of
  Definition 6.3 (`opensets`).
* `ℋ_A` (histories starting at `A`) is open and closed in `ℋ`, so a set `𝒰 ⊆ ℋ_A` is open in
  the subspace `ℋ_A` exactly when it is open in `ℋ`, and closures and interiors of subsets of
  `ℋ_A` taken in `ℋ_A` agree with those taken in `ℋ` intersected with `ℋ_A`. The statements
  below take them in `ℋ`.
-/

namespace BanachDensity1D

open Set Filter Topology

/-- The space `ℋ` of finite strictly descending chains of languages of `X`. -/
def History (X : Set (Set ℤ)) := {H : List (Set ℤ) // IsChain X H}

namespace History

variable {X : Set (Set ℤ)}

/-- `end(H)`. -/
def last (H : History X) : Set ℤ := chainEnd H.1

/-- The starting language of `H`. -/
def first (H : History X) : Set ℤ := start H.1

/-- The one-language history `(A)`. -/
def single (A : Set ℤ) (hA : A ∈ X) : History X :=
  ⟨[A], by simp [IsChain, hA]⟩

/-- `Γ` is the one-step extension `H⌢M` of `H` by a language `M ∈ X` with `M ⊊ end(H)`. -/
def IsSnoc (H Γ : History X) (M : Set ℤ) : Prop :=
  M ∈ X ∧ M ⊂ H.last ∧ Γ.1 = H.1 ++ [M]

end History

/-- `H` followed by a root-to-leaf path `P` of a tree rooted at `end(H)`, with the common
language `end(H)` written once: the list `H ++ P.tail`. -/
def appendPath (H P : List (Set ℤ)) : List (Set ℤ) := H ++ P.tail

/-- **Definition 6.2** (`def:safe-unsafe-history`). For a history `H` starting at `A`, `H` is
`(A,n,q)`-unsafe if some admissible obstruction tree rooted at `end(H)` has every root-to-leaf
path, appended to `H`, producing a history `H'` with `c_n(H') ≤ q`. (`A` is the starting
language of `H`, so it is not a separate argument.) -/
def def_safe_unsafe_history (X : Set (Set ℤ)) (n : ℕ) (q : ℝ) (H : List (Set ℤ)) : Prop :=
  ∃ T : LTree, def_aot X (chainEnd H) T ∧ ∀ P ∈ T.paths, cn (appendPath H P) n ≤ q

/-- **Definition 6.2**: `H` is `(A,n,q)`-safe if it is not `(A,n,q)`-unsafe. -/
def Safe (X : Set (Set ℤ)) (n : ℕ) (q : ℝ) (H : List (Set ℤ)) : Prop :=
  ¬ def_safe_unsafe_history X n q H

/-- The basic neighbourhood of `H` built from the finite tests `F` (Definition 6.3): the least
set of histories containing `H` and containing every one-step extension `Γ⌢M` with
`F Γ ⊆ M ⊊ end(Γ)`, `M ∈ X`, of each history `Γ` it contains. The test `F Γ` is chosen
separately for every history `Γ`. -/
inductive InBasic {X : Set (Set ℤ)} (H : History X) (F : History X → Set ℤ) : History X → Prop
  | base : InBasic H F H
  | step {Γ Γ' : History X} {M : Set ℤ} :
      InBasic H F Γ → History.IsSnoc Γ Γ' M → F Γ ⊆ M → InBasic H F Γ'

/-- An admissible choice of finite tests: `F Γ` is a finite subset of `end(Γ)` for every `Γ`. -/
def FiniteTests {X : Set (Set ℤ)} (F : History X → Set ℤ) : Prop :=
  ∀ Γ, (F Γ).Finite ∧ F Γ ⊆ Γ.last

/-- **Definition 6.3** (`opensets`): the basic open sets, i.e. the basic neighbourhoods
`{Γ | InBasic H F Γ}` for all starting histories `H` and all choices of finite tests `F`. -/
def opensets (X : Set (Set ℤ)) : Set (Set (History X)) :=
  {U | ∃ H : History X, ∃ F : History X → Set ℤ, FiniteTests F ∧ U = {Γ | InBasic H F Γ}}

/-- **Definition 6.3**: the finite-evidence history topology, generated by the basic open sets. -/
instance historyTopology (X : Set (Set ℤ)) : TopologicalSpace (History X) :=
  TopologicalSpace.generateFrom (opensets X)

/-- `ℋ_A`: the histories beginning at `A`. -/
def historiesFrom (X : Set (Set ℤ)) (A : Set ℤ) : Set (History X) := {H | H.first = A}

namespace HistoryTopologyAux

variable {X : Set (Set ℤ)}

/-- The end of a history is a language of `X`. -/
theorem last_mem (H : History X) : H.last ∈ X := by
  obtain ⟨hne, hX, -⟩ := H.2
  apply hX
  unfold History.last chainEnd
  rw [List.getLastD_eq_getLast?, List.getLast?_eq_some_getLast hne]
  exact List.getLast_mem hne

/-- `H⌢M` as a history, for `M ∈ X` with `M ⊊ end(H)`. -/
def snoc (H : History X) (M : Set ℤ) (hM : M ∈ X) (hlt : M ⊂ H.last) : History X :=
  ⟨H.1 ++ [M], by
    obtain ⟨hne, hX, hc⟩ := H.2
    refine ⟨by simp, ?_, ?_⟩
    · intro L hL
      rcases List.mem_append.1 hL with h | h
      · exact hX L h
      · rw [List.mem_singleton.1 h]; exact hM
    · refine hc.append (List.isChain_singleton M) ?_
      intro x hx y hy
      have hx' : x = H.last := by
        unfold History.last chainEnd
        rw [List.getLastD_eq_getLast?, hx]; rfl
      simp only [List.head?_cons, Option.mem_def, Option.some.injEq] at hy
      subst hx' hy
      exact hlt⟩

theorem snoc_isSnoc (H : History X) (M : Set ℤ) (hM : M ∈ X) (hlt : M ⊂ H.last) :
    History.IsSnoc H (snoc H M hM hlt) M := ⟨hM, hlt, rfl⟩

/-- The end of `H⌢M` is `M`. -/
theorem IsSnoc.last_eq {H Γ : History X} {M : Set ℤ} (h : History.IsSnoc H Γ M) :
    Γ.last = M := by
  unfold History.last chainEnd
  rw [h.2.2]; simp

/-- Appending a language does not change the starting language. -/
theorem IsSnoc.first_eq {H Γ : History X} {M : Set ℤ} (h : History.IsSnoc H Γ M) :
    Γ.first = H.first := by
  unfold History.first start
  rw [h.2.2]
  obtain ⟨hne, -, -⟩ := H.2
  cases hH : H.1 with
  | nil => exact absurd hH hne
  | cons a l => simp

/-- A root-to-leaf path starts with the root label. -/
theorem paths_head {T : LTree} {P : List (Set ℤ)} (hP : P ∈ T.paths) :
    ∃ Q, P = T.label :: Q := by
  cases T with
  | leaf L => exact ⟨[], hP⟩
  | node L c =>
    obtain ⟨i, Q, -, rfl⟩ := hP
    exact ⟨Q, rfl⟩

/-- Appending the tail of a path starting at `M` to `H⌢M` is appending the path to `H`. -/
theorem appendPath_snoc (H : History X) (M : Set ℤ) (hM : M ∈ X) (hlt : M ⊂ H.last)
    (L : Set ℤ) (Q : List (Set ℤ)) (hQ : ∃ Q', Q = M :: Q') :
    appendPath (snoc H M hM hlt).1 Q = appendPath H.1 (L :: Q) := by
  obtain ⟨Q', rfl⟩ := hQ
  simp [appendPath, snoc]

/-- Basic neighbourhoods are transitive: if `Γ ∈ B(H,F)` and `G ⊇ F` pointwise, then
`B(Γ,G) ⊆ B(H,F)`. -/
theorem inBasic_trans {H Γ : History X} {F G : History X → Set ℤ}
    (hΓ : InBasic H F Γ) (hFG : ∀ Δ, F Δ ⊆ G Δ) {Δ : History X} (hΔ : InBasic Γ G Δ) :
    InBasic H F Δ := by
  induction hΔ with
  | base => exact hΓ
  | step _ hs hM ih => exact InBasic.step ih hs ((hFG _).trans hM)

/-- The basic open sets form a basis of the history topology. -/
theorem isBasis : TopologicalSpace.IsTopologicalBasis (opensets X) := by
  refine ⟨?_, ?_, rfl⟩
  · rintro _ ⟨H₁, F₁, hF₁, rfl⟩ _ ⟨H₂, F₂, hF₂, rfl⟩ Γ ⟨h₁, h₂⟩
    refine ⟨{Δ | InBasic Γ (fun Δ => F₁ Δ ∪ F₂ Δ) Δ},
      ⟨Γ, _, fun Δ => ⟨(hF₁ Δ).1.union (hF₂ Δ).1, union_subset (hF₁ Δ).2 (hF₂ Δ).2⟩, rfl⟩,
      InBasic.base, fun Δ hΔ => ⟨?_, ?_⟩⟩
    · exact inBasic_trans h₁ (fun _ => subset_union_left) hΔ
    · exact inBasic_trans h₂ (fun _ => subset_union_right) hΔ
  · refine eq_univ_of_forall fun H => ?_
    exact ⟨_, ⟨H, fun _ => ∅, fun _ => ⟨finite_empty, empty_subset _⟩, rfl⟩, InBasic.base⟩

/-- The finite-test characterization of open sets (second part of Lemma 6.4). -/
theorem isOpen_iff (U : Set (History X)) : IsOpen U ↔
    ∀ H ∈ U, ∃ F : Set ℤ, F.Finite ∧ F ⊆ H.last ∧
      ∀ Γ : History X, ∀ M, History.IsSnoc H Γ M → F ⊆ M → Γ ∈ U := by
  constructor
  · intro hU H hH
    obtain ⟨t, ⟨H₀, F₀, hF₀, rfl⟩, hHt, htU⟩ := isBasis.exists_subset_of_mem_open hH hU
    exact ⟨F₀ H, (hF₀ H).1, (hF₀ H).2, fun Γ M hs hM => htU (InBasic.step hHt hs hM)⟩
  · intro h
    classical
    let F : History X → Set ℤ := fun H => if hH : H ∈ U then (h H hH).choose else ∅
    have hF : FiniteTests F := by
      intro H
      by_cases hH : H ∈ U
      · simp only [F, hH, ↓reduceDIte]
        exact ⟨(h H hH).choose_spec.1, (h H hH).choose_spec.2.1⟩
      · simp only [F, hH, ↓reduceDIte]
        exact ⟨finite_empty, empty_subset _⟩
    have key : ∀ H ∈ U, ∀ Γ, InBasic H F Γ → Γ ∈ U := by
      intro H hH Γ hΓ
      induction hΓ with
      | base => exact hH
      | @step Γ Γ' M _ hs hM ih =>
        have hM' : (h Γ ih).choose ⊆ M := by simpa only [F, ih, ↓reduceDIte] using hM
        exact (h Γ ih).choose_spec.2.2 Γ' M hs hM'
    refine isOpen_iff_forall_mem_open.2 fun H hH => ⟨{Γ | InBasic H F Γ}, key H hH, ?_,
      InBasic.base⟩
    exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨H, F, hF, rfl⟩

/-- `ℋ_A` is open. -/
theorem isOpen_historiesFrom (A : Set ℤ) : IsOpen (historiesFrom X A) := by
  rw [isOpen_iff]
  intro H hH
  exact ⟨∅, finite_empty, empty_subset _, fun Γ M hs _ => (IsSnoc.first_eq hs).trans hH⟩

/-- Every finite set of integers lies in some symmetric interval `[-N, N]`. -/
theorem finite_subset_Icc {F : Set ℤ} (hF : F.Finite) : ∃ N : ℕ, F ⊆ Icc (-(N : ℤ)) N := by
  obtain ⟨a, ha⟩ := hF.bddAbove
  obtain ⟨b, hb⟩ := hF.bddBelow
  refine ⟨max a.toNat (-b).toNat, fun x hx => ⟨?_, ?_⟩⟩
  · have := hb hx; push_cast; omega
  · have := ha hx; push_cast; omega

/-- Following an admissible obstruction tree rooted at `end(H)` whose appended paths lie in `D`
puts `H` in the closure of `D` (first half of Lemma 6.6). -/
theorem mem_closure_of_tree {D : Set (History X)} (T : LTree) :
    ∀ H : History X, def_aot X H.last T →
      (∀ P ∈ T.paths, ∃ G ∈ D, G.1 = appendPath H.1 P) → H ∈ closure D := by
  induction T with
  | leaf L =>
    intro H hT hP
    obtain ⟨G, hG, hGe⟩ := hP [L] rfl
    have : G = H := Subtype.ext (by simpa [appendPath] using hGe)
    exact subset_closure (this ▸ hG)
  | node L c ih =>
    intro H hT hP
    obtain ⟨hTL, hadm, hcov⟩ := hT
    change L = H.last at hTL
    subst hTL
    rw [mem_closure_iff]
    intro U hU hHU
    obtain ⟨F, hF, hFL, hsn⟩ := (isOpen_iff U).1 hU H hHU
    obtain ⟨i, hi⟩ := hcov F hF hFL
    obtain ⟨hiX, hilt, hiadm⟩ := hadm i
    have hHi : snoc H _ hiX hilt ∈ closure D := by
      refine ih i _ ⟨(IsSnoc.last_eq (snoc_isSnoc H _ hiX hilt)).symm, hiadm⟩ fun Q hQ => ?_
      obtain ⟨G, hG, hGe⟩ := hP (H.last :: Q) ⟨i, Q, hQ, rfl⟩
      exact ⟨G, hG, hGe.trans (appendPath_snoc H _ hiX hilt _ Q (paths_head hQ)).symm⟩
    exact mem_closure_iff.1 hHi U hU (hsn _ _ (snoc_isSnoc H _ hiX hilt) hi)

/-- The histories admitting an admissible obstruction tree whose appended paths lie in `D` form
a closed set (second half of Lemma 6.6). -/
theorem isClosed_treeSet (D : Set (History X)) :
    IsClosed {H : History X | ∃ T : LTree, def_aot X H.last T ∧
      ∀ P ∈ T.paths, ∃ G ∈ D, G.1 = appendPath H.1 P} := by
  set W := {H : History X | ∃ T : LTree, def_aot X H.last T ∧
      ∀ P ∈ T.paths, ∃ G ∈ D, G.1 = appendPath H.1 P} with hWdef
  rw [← isOpen_compl_iff, isOpen_iff]
  intro H hH
  by_contra hne
  push Not at hne
  apply hH
  have hS : {F : Set ℤ | F.Finite ∧ F ⊆ H.last}.Countable :=
    Set.countable_ofPred_finite_subset (Set.to_countable _)
  obtain ⟨e, he⟩ := hS.exists_eq_range ⟨∅, finite_empty, empty_subset _⟩
  have he' : ∀ i, (e i).Finite ∧ e i ⊆ H.last := fun i => by
    have : e i ∈ range e := mem_range_self i
    rw [← he] at this
    exact this
  choose Γ M hs hFM hW using fun i => hne (e i) (he' i).1 (he' i).2
  simp only [mem_compl_iff, not_not] at hW
  choose T hT hTP using hW
  refine ⟨LTree.node H.last T, ⟨rfl, ?_, ?_⟩, ?_⟩
  · intro i
    have hl : (T i).label = M i := (hT i).1.trans (IsSnoc.last_eq (hs i))
    rw [hl]
    exact ⟨(hs i).1, (hs i).2.1, (hT i).2⟩
  · intro F hF hFL
    have : F ∈ range e := by rw [← he]; exact ⟨hF, hFL⟩
    obtain ⟨i, rfl⟩ := this
    exact ⟨i, (hFM i).trans (((hT i).1.trans (IsSnoc.last_eq (hs i))).symm ▸ subset_rfl)⟩
  · rintro P ⟨i, Q, hQ, rfl⟩
    obtain ⟨G, hG, hGe⟩ := hTP i Q hQ
    refine ⟨G, hG, hGe.trans ?_⟩
    obtain ⟨Q', rfl⟩ := paths_head hQ
    have hl : (T i).label = M i := (hT i).1.trans (IsSnoc.last_eq (hs i))
    rw [hl, (hs i).2.2]
    simp [appendPath]

/-- Appending a root-to-leaf path of an admissible tree rooted at `end(H)` gives a history with
the same starting language. -/
theorem exists_appendPath (T : LTree) :
    ∀ H : History X, def_aot X H.last T → ∀ P ∈ T.paths,
      ∃ G : History X, G.1 = appendPath H.1 P ∧ G.first = H.first := by
  induction T with
  | leaf L =>
    intro H _ P hP
    refine ⟨H, ?_, rfl⟩
    rw [show P = [L] from hP]
    simp [appendPath]
  | node L c ih =>
    intro H hT P hP
    obtain ⟨hTL, hadm, -⟩ := hT
    change L = H.last at hTL
    subst hTL
    obtain ⟨i, Q, hQ, rfl⟩ := hP
    obtain ⟨hiX, hilt, hiadm⟩ := hadm i
    obtain ⟨G, hG, hGf⟩ := ih i (snoc H _ hiX hilt)
      ⟨(IsSnoc.last_eq (snoc_isSnoc H _ hiX hilt)).symm, hiadm⟩ Q hQ
    exact ⟨G, hG.trans (appendPath_snoc H _ hiX hilt _ Q (paths_head hQ)),
      hGf.trans (IsSnoc.first_eq (snoc_isSnoc H _ hiX hilt))⟩

end HistoryTopologyAux

/-- **Lemma 6.4** (`lem:history-topology`). The basic open sets form a basis of the topology, and
`U ⊆ ℋ` is open iff for every `H ∈ U` there is a finite `F_H ⊆ end(H)` such that every `M ∈ X`
with `F_H ⊆ M ⊊ end(H)` has `H⌢M ∈ U`. -/
theorem lem_history_topology (X : Set (Set ℤ)) :
    TopologicalSpace.IsTopologicalBasis (opensets X) ∧
    ∀ U : Set (History X), IsOpen U ↔
      ∀ H ∈ U, ∃ F : Set ℤ, F.Finite ∧ F ⊆ H.last ∧
        ∀ Γ : History X, ∀ M, History.IsSnoc H Γ M → F ⊆ M → Γ ∈ U :=
  ⟨HistoryTopologyAux.isBasis, HistoryTopologyAux.isOpen_iff⟩

/-- The continuation property of Lemma 6.5 for a topology `σ` on `ℋ`: whenever `H` ends at `L`
and `M₁, M₂, …` are proper refinements of `L` in `X` with `M_j → L` in the finite-evidence
topology on `X`, then `H⌢M_j → H` in `σ`. -/
def ContinuationProperty (X : Set (Set ℤ)) (σ : TopologicalSpace (History X)) : Prop :=
  ∀ (H : History X) (hL : H.last ∈ X) (M : ℕ → X) (Γ : ℕ → History X),
    (∀ j, History.IsSnoc H (Γ j) (M j).1) →
    Tendsto M atTop (@nhds X (evidenceTopology X) ⟨H.last, hL⟩) →
    Tendsto Γ atTop (@nhds _ σ H)

/-- **Lemma 6.5** (`lem:finest-history-topology`). The finite-evidence history topology has the
continuation property, and it is the finest topology on `ℋ` that does: every topology `σ` with
the property is coarser (`historyTopology X ≤ σ` in Mathlib's order, where `≤` means finer).
The hypothesis `hX : LangClass X` mirrors the paper's standing class `X`; the Lean proof does not
use it. -/
theorem lem_finest_history_topology {X : Set (Set ℤ)} (hX : LangClass X) :
    ContinuationProperty X (historyTopology X) ∧
    ∀ σ : TopologicalSpace (History X), ContinuationProperty X σ → historyTopology X ≤ σ := by
  let _ : TopologicalSpace X := evidenceTopology X
  refine ⟨?_, ?_⟩
  · intro H hL M Γ hs hM
    rw [tendsto_nhds]
    intro U hU hHU
    obtain ⟨F, hF, hFL, hsn⟩ := (HistoryTopologyAux.isOpen_iff U).1 hU H hHU
    have hev : evidenceSet X H.last F ∈ 𝓝 (⟨H.last, hL⟩ : X) :=
      IsOpen.mem_nhds (TopologicalSpace.isOpen_generateFrom_of_mem ⟨H.last, hL, F, hF, hFL, rfl⟩)
        ⟨hFL, subset_rfl⟩
    filter_upwards [hM hev] with j hj
    exact hsn (Γ j) _ (hs j) hj.1
  · intro σ hσ
    rw [TopologicalSpace.le_def]
    intro U hU
    rw [HistoryTopologyAux.isOpen_iff]
    intro H hH
    by_contra hne
    push Not at hne
    have hL : H.last ∈ X := HistoryTopologyAux.last_mem H
    choose Γ M hs hFM hnot using fun j : ℕ =>
      hne (H.last ∩ Icc (-(j : ℤ)) j) ((finite_Icc _ _).inter_of_right _) inter_subset_left
    let M' : ℕ → X := fun j => ⟨M j, (hs j).1⟩
    have hconv : Tendsto M' atTop (𝓝 (⟨H.last, hL⟩ : X)) := by
      rw [TopologicalSpace.nhds_generateFrom]
      simp only [tendsto_iInf, tendsto_principal]
      rintro s ⟨hLs, L', hL', F', hF', hF'L', rfl⟩
      obtain ⟨N, hN⟩ := HistoryTopologyAux.finite_subset_Icc hF'
      refine Filter.eventually_atTop.2 ⟨N, fun j hj => ⟨?_, ?_⟩⟩
      · intro x hx
        refine hFM j ⟨hLs.1 hx, ?_⟩
        have := hN hx
        exact ⟨le_trans (by simp; omega) this.1, this.2.trans (by exact_mod_cast hj)⟩
      · exact (hs j).2.1.subset.trans hLs.2
    have hT := hσ H hL M' Γ hs hconv
    obtain ⟨j, hj⟩ := (hT.eventually (@IsOpen.mem_nhds _ σ _ _ hU hH)).exists
    exact hnot j hj

/-- **Lemma 6.6** (`lem:obstruction-closure`). Let `𝒟 ⊆ ℋ_A` and `H ∈ ℋ_A`. Then `H` is in the
closure of `𝒟` iff there is an admissible obstruction tree rooted at `end(H)` such that every
root-to-leaf path, appended to `H`, produces a history in `𝒟`. The hypotheses `hX`, `hA`, `hD`
and `hH` mirror the paper's statement (its restriction to `ℋ_A` with `𝒟 ⊆ ℋ_A`); the Lean proof
does not use them. -/
theorem lem_obstruction_closure {X : Set (Set ℤ)} (hX : LangClass X) {A : Set ℤ} (hA : A ∈ X)
    {D : Set (History X)} (hD : D ⊆ historiesFrom X A) {H : History X}
    (hH : H ∈ historiesFrom X A) :
    H ∈ closure D ↔ ∃ T : LTree, def_aot X H.last T ∧
      ∀ P ∈ T.paths, ∃ G ∈ D, G.1 = appendPath H.1 P := by
  constructor
  · intro hcl
    refine closure_minimal (fun G hG => ?_) (HistoryTopologyAux.isClosed_treeSet D) hcl
    refine ⟨LTree.leaf G.last, ⟨rfl, trivial⟩, fun P hP => ⟨G, hG, ?_⟩⟩
    rw [show P = [G.last] from hP]
    simp [appendPath]
  · rintro ⟨T, hT, hP⟩
    exact HistoryTopologyAux.mem_closure_of_tree T H hT hP

/-- **Corollary 6.7** (`cor:safety-interior`). A history `H ∈ ℋ_A` is `(A,n,q)`-unsafe iff it is
in the closure of `{G ∈ ℋ_A : c_n(G) ≤ q}`; equivalently, it is `(A,n,q)`-safe iff it is in the
interior of `{G ∈ ℋ_A : c_n(G) > q}`. Under the standing parameters of Section 6.3.1: `A ∈ X`, `n ≥ 1`,
`q < b_n(A)`. The hypotheses `hn` and `hq` mirror these standing parameters of the paper; the
Lean proof does not use them. -/
theorem cor_safety_interior {X : Set (Set ℤ)} (hX : LangClass X) {A : Set ℤ} (hA : A ∈ X)
    {n : ℕ} {q : ℝ} (hn : 1 ≤ n) (hq : q < bn X A n) {H : History X}
    (hH : H ∈ historiesFrom X A) :
    (def_safe_unsafe_history X n q H.1 ↔
        H ∈ closure {G | G ∈ historiesFrom X A ∧ cn G.1 n ≤ q}) ∧
    (Safe X n q H.1 ↔ H ∈ interior {G | G ∈ historiesFrom X A ∧ q < cn G.1 n}) := by
  set D := {G : History X | G ∈ historiesFrom X A ∧ cn G.1 n ≤ q} with hDdef
  have h1 : def_safe_unsafe_history X n q H.1 ↔ H ∈ closure D := by
    rw [lem_obstruction_closure hX hA (fun G hG => hG.1) hH]
    constructor
    · rintro ⟨T, hT, hP⟩
      refine ⟨T, hT, fun P hPm => ?_⟩
      obtain ⟨G, hG1, hGf⟩ := HistoryTopologyAux.exists_appendPath T H hT P hPm
      exact ⟨G, ⟨hGf.trans hH, hG1 ▸ hP P hPm⟩, hG1⟩
    · rintro ⟨T, hT, hP⟩
      refine ⟨T, hT, fun P hPm => ?_⟩
      obtain ⟨G, ⟨-, hc⟩, hG⟩ := hP P hPm
      rw [← hG]
      exact hc
  refine ⟨h1, ?_⟩
  have hS : {G : History X | G ∈ historiesFrom X A ∧ q < cn G.1 n} = historiesFrom X A ∩ Dᶜ := by
    ext G
    simp only [hDdef, mem_ofPred_eq, mem_inter_iff, mem_compl_iff, not_and, not_le]
    exact ⟨fun h => ⟨h.1, fun _ => h.2⟩, fun h => ⟨h.1, h.2 h.1⟩⟩
  rw [hS, interior_inter, (HistoryTopologyAux.isOpen_historiesFrom A).interior_eq,
    interior_compl, Safe, h1]
  exact ⟨fun h => ⟨hH, h⟩, fun h => h.2⟩

/-- The topological value `sup_{𝒰 ⊆ ℋ_A open, (A) ∈ 𝒰} inf_{H ∈ 𝒰} c_n(H)` of equation (10). -/
noncomputable def bnTop (X : Set (Set ℤ)) (A : Set ℤ) (n : ℕ) : ℝ :=
  ⨆ U : {U : Set (History X) // IsOpen U ∧ U ⊆ historiesFrom X A ∧
      ∃ hA : A ∈ X, History.single A hA ∈ U},
    ⨅ H : U.1, cn H.1.1 n

namespace HistoryTopologyAux

variable {X : Set (Set ℤ)}

/-- `0 ≤ c_n(H) ≤ 1/2` for every history of a language class. -/
theorem cn_history_bounds (hX : LangClass X) (H : History X) (n : ℕ) :
    0 ≤ cn H.1 n ∧ cn H.1 n ≤ 1 / 2 := by
  obtain ⟨-, -, h0, h1⟩ :=
    ChainsAux.cn_tendsto H.2.1 H.2.2.2 (ChainsAux.start_infinite hX H.2) n
  exact ⟨h0, h1⟩

/-- `(A) ∈ ℋ_A`. -/
theorem single_mem_historiesFrom {A : Set ℤ} (hA : A ∈ X) :
    History.single A hA ∈ historiesFrom X A := rfl

/-- Appending a path of a tree rooted at `K` to the one-language history `(K)` gives the path. -/
theorem appendPath_single {T : LTree} {K : Set ℤ} (hT : T.label = K) {P : List (Set ℤ)}
    (hP : P ∈ T.paths) : appendPath [K] P = P := by
  obtain ⟨Q, rfl⟩ := paths_head hP
  simp [appendPath, hT]

/-- For an infinite `K` and `q < b_n(K)`, the one-language history `(K)` is `(K,n,q)`-safe. -/
theorem single_safe {K : Set ℤ} (hK : K.Infinite) {n : ℕ} {q : ℝ} (hq : q < bn X K n) :
    Safe X n q [K] := by
  rintro ⟨T, hT, hP⟩
  have hTK : def_aot X K T := by simpa [chainEnd] using hT
  have : Nonempty T.paths := (ChainsAux.paths_nonempty T).to_subtype
  have hle : bn X K n ≤ ⨆ H : T.paths, cn H.1 n :=
    ciInf_le (ChainsAux.bn_bddBelow hK n) ⟨T, hTK⟩
  have hsup : (⨆ H : T.paths, cn H.1 n) ≤ q := by
    refine ciSup_le fun H => ?_
    have h := hP H.1 H.2
    rwa [appendPath_single hTK.1 H.2] at h
  linarith

/-- Inside an open set containing `H`, one can follow some root-to-leaf path of any admissible
obstruction tree rooted at `end(H)` (from Lemma 6.6 applied to the complement). -/
theorem exists_path_mem_open {U : Set (History X)} (hU : IsOpen U) {H : History X}
    (hH : H ∈ U) {T : LTree} (hT : def_aot X H.last T) :
    ∃ P ∈ T.paths, ∃ G ∈ U, G.1 = appendPath H.1 P := by
  by_contra hcon
  push Not at hcon
  have hcl : H ∈ closure Uᶜ := mem_closure_of_tree T H hT fun P hP => by
    obtain ⟨G, hG, -⟩ := exists_appendPath T H hT P hP
    exact ⟨G, fun hGU => hcon P hP G hGU hG, hG⟩
  rw [closure_compl, hU.interior_eq] at hcl
  exact hcl hH

/-- The inner infimum of `bnTop` lies in `[0, 1/2]` (the open set contains `(A)`). -/
theorem inner_bounds (hX : LangClass X) {A : Set ℤ} (n : ℕ)
    (U : {U : Set (History X) // IsOpen U ∧ U ⊆ historiesFrom X A ∧
      ∃ hA : A ∈ X, History.single A hA ∈ U}) :
    BddBelow (range fun H : U.1 => cn H.1.1 n) ∧
      0 ≤ (⨅ H : U.1, cn H.1.1 n) ∧ (⨅ H : U.1, cn H.1.1 n) ≤ 1 / 2 := by
  obtain ⟨hA, hs⟩ := U.2.2.2
  have hb : BddBelow (range fun H : U.1 => cn H.1.1 n) :=
    ⟨0, by rintro _ ⟨H, rfl⟩; exact (cn_history_bounds hX H.1 n).1⟩
  have : Nonempty U.1 := ⟨⟨_, hs⟩⟩
  exact ⟨hb, le_ciInf fun H => (cn_history_bounds hX H.1 n).1,
    (ciInf_le hb ⟨_, hs⟩).trans (cn_history_bounds hX _ n).2⟩

end HistoryTopologyAux

/-- **Theorem 3.6** (`thm:topological-bn`), equation (10). For every `K ∈ X` and every positive
integer `n`, `b_n(K) = sup_{𝒰 ⊆ ℋ_K open, (K) ∈ 𝒰} inf_{H ∈ 𝒰} c_n(H)`. The hypothesis
`hn : 1 ≤ n` mirrors the paper's statement ("for every positive integer `n`"); the Lean proof does
not use it (it is only passed on to `cor_safety_interior`, where it is idle). -/
theorem thm_topological_bn {X : Set (Set ℤ)} (hX : LangClass X) {K : Set ℤ} (hK : K ∈ X)
    {n : ℕ} (hn : 1 ≤ n) : bn X K n = bnTop X K n := by
  open HistoryTopologyAux in
  have hKi : K.Infinite := hX.infinite K hK
  have hne : Nonempty {U : Set (History X) // IsOpen U ∧ U ⊆ historiesFrom X K ∧
      ∃ hA : K ∈ X, History.single K hA ∈ U} :=
    ⟨⟨historiesFrom X K, isOpen_historiesFrom K, subset_rfl, hK, single_mem_historiesFrom hK⟩⟩
  have hbdd : BddAbove (range fun U : {U : Set (History X) // IsOpen U ∧
      U ⊆ historiesFrom X K ∧ ∃ hA : K ∈ X, History.single K hA ∈ U} =>
      ⨅ H : U.1, cn H.1.1 n) :=
    ⟨1 / 2, by rintro _ ⟨U, rfl⟩; exact (inner_bounds hX n U).2.2⟩
  apply le_antisymm
  · -- `q < b_n(K)` ⟹ `(K)` safe ⟹ its interior neighbourhood has scores `> q`.
    have key : ∀ q, q < bn X K n → q ≤ bnTop X K n := by
      intro q hq
      have hsafe := single_safe (hX.infinite K hK) hq
      have hint := ((cor_safety_interior hX hK hn hq
        (single_mem_historiesFrom hK)).2.1 hsafe)
      let U : {U : Set (History X) // IsOpen U ∧ U ⊆ historiesFrom X K ∧
          ∃ hA : K ∈ X, History.single K hA ∈ U} :=
        ⟨_, isOpen_interior, fun G hG => (interior_subset hG).1, hK, hint⟩
      have : Nonempty U.1 := ⟨⟨_, hint⟩⟩
      refine le_trans ?_ (le_ciSup hbdd U)
      exact le_ciInf fun H => (interior_subset H.2).2.le
    by_contra h
    push Not at h
    have := key ((bnTop X K n + bn X K n) / 2) (by linarith)
    linarith
  · refine ciSup_le fun U => ?_
    have : Nonempty {T : LTree // def_aot X K T} := ⟨⟨LTree.leaf K, rfl, trivial⟩⟩
    refine le_ciInf fun T => ?_
    obtain ⟨hA, hs⟩ := U.2.2.2
    obtain ⟨P, hP, G, hGU, hGe⟩ :=
      exists_path_mem_open U.2.1 hs (T := T.1) (show def_aot X K T.1 from T.2)
    calc (⨅ H : U.1, cn H.1.1 n) ≤ cn G.1 n := ciInf_le (inner_bounds hX n U).1 ⟨G, hGU⟩
      _ = cn P n := by rw [hGe]; exact congrArg (cn · n) (appendPath_single T.2.1 hP)
      _ ≤ ⨆ H : T.1.paths, cn H.1 n :=
        le_ciSup (ChainsAux.pathSup_bdd T.2.2 (by rw [T.2.1]; exact hKi) n) ⟨P, hP⟩

/-- **Theorem 6.8** (`thm:topological-bn-restated`): Theorem 3.6 restated with `K` renamed `A`.
For every `A ∈ X` and every positive integer `n`,
`b_n(A) = sup_{𝒰 ⊆ ℋ_A open, (A) ∈ 𝒰} inf_{H ∈ 𝒰} c_n(H)`. The hypothesis `hn : 1 ≤ n`
mirrors the paper's statement ("every positive integer `n`"); the Lean proof does not use it (it
is only passed on to `thm_topological_bn`, where it is idle). -/
theorem thm_topological_bn_restated {X : Set (Set ℤ)} (hX : LangClass X) {A : Set ℤ}
    (hA : A ∈ X) {n : ℕ} (hn : 1 ≤ n) : bn X A n = bnTop X A n :=
  thm_topological_bn hX hA hn

/-- **Corollary 6.10** (`cor:protected-set`). Fix `A ∈ X`, `n ≥ 1` and `q < b_n(A)`. Then
1. the one-language history `(A)` is `(A,n,q)`-safe;
2. every `(A,n,q)`-safe history `H` satisfies `c_n(H) > q`;
3. if an `(A,n,q)`-safe history `H` ends at `M`, there is a finite `Prot(H) ⊆ M` such that every
   `L ∈ X` with `Prot(H) ⊆ L ⊊ M` makes `H⌢L` `(A,n,q)`-safe.

The hypothesis `hn` mirrors the paper's standing parameter `n ≥ 1` (Section 6.3.1); the Lean proof
does not use it (it is only passed on to `cor_safety_interior`, where it is idle). -/
theorem cor_protected_set {X : Set (Set ℤ)} (hX : LangClass X) {A : Set ℤ} (hA : A ∈ X)
    {n : ℕ} (hn : 1 ≤ n) {q : ℝ} (hq : q < bn X A n) :
    Safe X n q [A] ∧
    (∀ H : History X, H ∈ historiesFrom X A → Safe X n q H.1 → q < cn H.1 n) ∧
    (∀ H : History X, H ∈ historiesFrom X A → Safe X n q H.1 →
      ∃ P : Set ℤ, P.Finite ∧ P ⊆ H.last ∧
        ∀ L ∈ X, P ⊆ L → L ⊂ H.last → Safe X n q (H.1 ++ [L])) := by
  refine ⟨HistoryTopologyAux.single_safe (hX.infinite A hA) hq, fun H hH hs => ?_,
    fun H hH hs => ?_⟩
  · exact (interior_subset ((cor_safety_interior hX hA hn hq hH).2.1 hs)).2
  · have hint := (cor_safety_interior hX hA hn hq hH).2.1 hs
    obtain ⟨F, hF, hFL, hsn⟩ := (HistoryTopologyAux.isOpen_iff _).1 isOpen_interior H hint
    refine ⟨F, hF, hFL, fun L hL hFL' hLlt => ?_⟩
    have hsn' := HistoryTopologyAux.snoc_isSnoc H L hL hLlt
    have hΓ := hsn _ L hsn' hFL'
    have hΓA : HistoryTopologyAux.snoc H L hL hLlt ∈ historiesFrom X A :=
      (HistoryTopologyAux.IsSnoc.first_eq hsn').trans hH
    exact (cor_safety_interior hX hA hn hq hΓA).2.2 hΓ

/-- **Remark 1** (`rem:safety-local-score`). Safety gives a local score guarantee: if `H` (starting
at `A`) is `(A,n,q)`-safe, then every relative interval `J` of `A` with `|J| ≥ n` and far enough
from the origin has `p(H,J) > q`. The radius may depend on `H`. Under the standing parameters of
Section 6.3.1 (`A ∈ X`, `n ≥ 1`, `q < b_n(A)`), as in Corollary 6.10. The hypotheses `hA`, `hn`
and `hq` mirror these standing parameters of the paper; the Lean proof does not use them: the
proof uses only item 2 of `cor_protected_set`, which does not need them (item 1 of
`cor_protected_set` does use `hA` and `hq`). -/
theorem rem_safety_local_score {X : Set (Set ℤ)} (hX : LangClass X) {A : Set ℤ} (hA : A ∈ X)
    {n : ℕ} {q : ℝ} (hn : 1 ≤ n) (hq : q < bn X A n) {H : History X}
    (hH : H ∈ historiesFrom X A) (hsafe : Safe X n q H.1) :
    ∃ R : ℕ, ∀ J, IsRelInterval A J → n ≤ J.ncard → Disjoint J (Icc (-(R : ℤ)) R) →
      q < def_raw_pairing_score H.1 J := by
  have hc := (cor_protected_set hX hA hn hq).2.1 H hH hsafe
  obtain ⟨R, hR⟩ := claim_cn_eventual_interval_bound hX H.2 hc
  refine ⟨R, fun J hJ hnJ hd => hR J ?_ hnJ hd⟩
  have : start H.1 = A := hH
  rw [this]; exact hJ

/-- **Definition 6.11** (`def:history-protected-set`). A protected set with respect to a safe
history `H` ending at `M` (for the parameters `(A,n,q)`, `A` the start of `H`): a finite
`P ⊆ M` such that every `L ∈ X` with `P ⊆ L ⊊ M` makes `H⌢L` `(A,n,q)`-safe (Item 3 of
Corollary 6.10). -/
def def_history_protected_set (X : Set (Set ℤ)) (n : ℕ) (q : ℝ) (H : List (Set ℤ))
    (P : Set ℤ) : Prop :=
  P.Finite ∧ P ⊆ chainEnd H ∧ ∀ L ∈ X, P ⊆ L → L ⊂ chainEnd H → Safe X n q (H ++ [L])

end BanachDensity1D
