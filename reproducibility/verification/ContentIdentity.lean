set_option maxRecDepth 8192
open Lean

def releaseNode (tag : String) (fields : Array Json) : Json :=
  Json.arr (#[toJson tag] ++ fields)

/-- Sharing-preserving expression serialization; source metadata is omitted. -/
partial def releaseTypeGraph (e : Expr) : StateM (Std.HashMap Expr Nat × Array Json) Nat := do
  if let .mdata _ v := e then return ← releaseTypeGraph v
  if let some id := (← get).1[e]? then return id
  let node ← match e with
    | .bvar n => pure <| releaseNode "bvar" #[toJson n]
    | .fvar n => pure <| releaseNode "fvar" #[toJson n.name.toString]
    | .mvar n => pure <| releaseNode "mvar" #[toJson n.name.toString]
    | .sort l => pure <| releaseNode "sort" #[toJson (reprStr l)]
    | .const n ls => pure <| releaseNode "const" #[toJson n.toString, toJson (ls.map reprStr)]
    | .app f a => do
        let f ← releaseTypeGraph f; let a ← releaseTypeGraph a
        pure <| releaseNode "app" #[toJson f, toJson a]
    | .lam n t b bi => do
        let t ← releaseTypeGraph t; let b ← releaseTypeGraph b
        pure <| releaseNode "lam" #[toJson n.toString, toJson t, toJson b, toJson (reprStr bi)]
    | .forallE n t b bi => do
        let t ← releaseTypeGraph t; let b ← releaseTypeGraph b
        pure <| releaseNode "forall" #[toJson n.toString, toJson t, toJson b, toJson (reprStr bi)]
    | .letE n t v b nd => do
        let t ← releaseTypeGraph t; let v ← releaseTypeGraph v; let b ← releaseTypeGraph b
        pure <| releaseNode "let" #[toJson n.toString, toJson t, toJson v, toJson b, toJson nd]
    | .lit l => pure <| releaseNode "lit" #[toJson (reprStr l)]
    | .proj n i e => do
        let e ← releaseTypeGraph e
        pure <| releaseNode "proj" #[toJson n.toString, toJson i, toJson e]
    | .mdata _ _ => pure Json.null
  let id := (← get).2.size
  modify fun (seen, nodes) => (seen.insert e id, nodes.push node)
  return id

run_cmd do
  let env ← getEnv
  let mut count : Nat := 0
  for (n, ci) in env.constants.toList do
    let ours := match env.getModuleIdxFor? n with
      | some i =>
        let m := env.header.moduleNames[i.toNat]!
        (`BanachDensityHD).isPrefixOf m || (`BanachDensity1D).isPrefixOf m || m == `BanachDensity1DOct31 || m == `BanachDensityHDOct31 || m == `BanachDensity1DPriorZero || m == `TriangularSchedule
      | none => false
    if ours then
      count := count + 1
      let (root, (_, nodes)) := (releaseTypeGraph ci.type).run ({}, #[])
      let deps := ((ci.value? true).map (fun e => e.getUsedConstants.toList.map Name.toString)).getD []
      let deps := deps.eraseDups.mergeSort (· < ·)
      let typedeps := (ci.type.getUsedConstants.toList.map Name.toString).eraseDups.mergeSort (· < ·)
      let j := Json.mkObj [("name", toJson n.toString), ("type_root", toJson root), ("type_nodes", Json.arr nodes),
        ("type_dependencies", toJson typedeps), ("value_dependencies", toJson deps)]
      IO.println s!"CONTENT_JSON {j.compress}"
  unless count == 5298 do
    throwError "Unexpected declaration count: {count}"
